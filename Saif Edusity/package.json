{
    "name": "edusity",
    "version": "1.0.0",
    "description": "Full-stack Educational Platform",
    "private": true,
    "scripts": {
        "scripts-install": "npm install --prefix client && npm install --prefix server",
        "client-install": "npm install --prefix client",
        "server-install": "npm install --prefix server",
        "client-build": "npm run build --prefix client",
        "server-dev": "npm run dev --prefix server",
        "client-dev": "npm run dev --prefix client",
        "dev": "concurrently \"npm run server-dev\" \"npm run client-dev\"",
        "build": "npm run client-build",
        "start": "node server/src/index.js",
        "start:prod": "NODE_ENV=production node server/src/index.js"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}